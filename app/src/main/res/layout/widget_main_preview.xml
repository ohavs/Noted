<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:layoutDirection="rtl"
    android:background="@drawable/wg_preview_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_preview_cat" android:textSize="26sp" android:textStyle="bold"
        android:textColor="@color/wg_ink" android:fontFamily="@font/fredoka" android:paddingBottom="10dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp" android:background="@drawable/wg_preview_butter">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widget_preview_note1" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/wg_note_ink" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="6dp"
            android:text="@string/widget_preview_line1" android:textSize="13sp" android:textColor="@color/wg_note_ink" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:orientation="vertical" android:padding="14dp" android:background="@drawable/wg_preview_mint">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widget_preview_note2" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/wg_note_ink" />
    </LinearLayout>
</LinearLayout>
