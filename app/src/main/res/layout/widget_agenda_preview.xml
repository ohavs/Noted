<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:layoutDirection="rtl"
    android:background="@drawable/wg_preview_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_agenda_title" android:textSize="30sp"
        android:textColor="@color/wg_ink" android:fontFamily="@font/karantina_bold" android:paddingBottom="6dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp"
        android:background="@drawable/wg_preview_butter" android:text="@string/widget_agenda_preview_1"
        android:textSize="14sp" android:textStyle="bold" android:textColor="@color/wg_note_ink" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:layout_marginTop="6dp"
        android:background="@drawable/wg_preview_mint" android:text="@string/widget_agenda_preview_2"
        android:textSize="14sp" android:textColor="@color/wg_note_ink" />
</LinearLayout>
