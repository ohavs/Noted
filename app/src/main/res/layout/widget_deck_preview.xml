<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:layoutDirection="rtl"
    android:background="@drawable/wg_preview_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_preview_cat" android:textSize="30sp"
        android:textColor="@color/wg_ink" android:fontFamily="@font/karantina_bold" android:paddingBottom="6dp" android:paddingStart="4dp" />
    <TextView android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="-14dp"
        android:background="@drawable/wg_preview_mint" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="9dp"
        android:text="@string/widget_deck_preview_2" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/wg_note_ink" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp" android:background="@drawable/wg_preview_note">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_deck_preview_1" android:textSize="26sp"
            android:textColor="@color/wg_note_ink" android:fontFamily="@font/karantina_bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp"
            android:text="@string/widget_note_preview_1" android:textSize="14sp" android:textColor="@color/wg_note_ink" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp"
            android:text="@string/widget_note_preview_2" android:textSize="14sp" android:textColor="@color/wg_note_ink" />
    </LinearLayout>
</LinearLayout>
