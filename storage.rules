rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media of a user's notes; names are random, files ≤ 40 MB.
    match /users/{uid}/media/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || request.resource.size < 40 * 1024 * 1024);
    }
  }
}
